<Project Sdk="Microsoft.NET.Sdk">
  <!-- A media file as an MSFP copy, with ffprobe: the Go engine's package
       describe in C#. -->
  <PropertyGroup>
    <RootNamespace>Msfp.Describe</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Description>MSFP's copies from media files: the media type from a file's first bytes, ffprobe run safely (the sniffed demuxer, the file protocol only, bounded runs, codec records read apart, attachments never read), RFC 6381 codecs strings from the codec records, and the copy shaped in MSFP Media's vocabularies (MSFP Media video 3.2 to 3.6, the registry). The counterpart of msfp-go's describe package.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Msfp.Protocol/Msfp.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../logo.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Msfp.Describe.Tests" />
  </ItemGroup>
</Project>
